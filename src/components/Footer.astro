---
import { COMPANY_EMAIL, COMPANY_NAME, COMPANY_ORG_NR, DISCLOSURE } from '../lib/site';

interface IconProps {
  class?: string;
  'aria-hidden'?: string | boolean;
}

const navigation = {
  main: [
    { name: 'Hem', href: '/', description: 'Gå till startsidan' },
    { name: 'Tjänster', href: '/tjanster', description: 'Se elarbeten du kan skicka förfrågan om' },
    { name: 'Områden', href: '/omraden', description: 'Områden i Södertälje med omnejd' },
    { name: 'Om oss', href: '/om-oss', description: 'Läs mer om förmedlingstjänsten' },
    { name: 'Blogg', href: '/blogg', description: 'Tips och råd om el' },
    { name: 'Kontakt', href: '/kontakt', description: 'Skicka förfrågan' },
  ],
  services: [
    { name: 'Elinstallation', href: '/tjanster#elinstallation', description: 'Elinstallation' },
    { name: 'Elbilsladdare', href: '/tjanster#elbilsladdare', description: 'Elbilsladdare' },
    { name: 'Akuta elproblem', href: '/tjanster#akut-hjalp', description: 'Vad du ska göra vid akuta elproblem' },
    { name: 'Renovering', href: '/tjanster#renovering', description: 'Elrenovering' },
    { name: 'Företagstjänster', href: '/tjanster#foretagstjanster', description: 'Eltjänster för företag' },
    { name: 'Energioptimering', href: '/tjanster#energioptimering', description: 'Energieffektivisering' },
  ],
  areas: [
    { name: 'Centrala Södertälje', href: '/omraden/centrala-sodertalje', description: 'Elektriker i Centrala Södertälje' },
    { name: 'Järna', href: '/omraden/jarna', description: 'Elektriker i Järna' },
    { name: 'Hölö', href: '/omraden/holo', description: 'Elektriker i Hölö' },
    { name: 'Pershagen', href: '/omraden/pershagen', description: 'Elektriker i Pershagen' },
    { name: 'Östertälje', href: '/omraden/ostertalje', description: 'Elektriker i Östertälje' },
  ],
};
---

<footer class="bg-gray-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="container py-12 lg:py-16">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8 xl:col-span-1">
        <a href="/" class="flex items-center space-x-2" aria-label="Elektriker Södertälje - Gå till startsidan">
          <svg class="w-8 h-8 text-primary-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3v2m0 14v2M5.636 5.636l1.414 1.414m9.9 9.9l1.414 1.414M3 12h2m14 0h2M5.636 18.364l1.414-1.414m9.9-9.9l1.414-1.414M12 7a5 5 0 015 5 5 5 0 01-5 5 5 5 0 01-5-5 5 5 0 015-5z" />
          </svg>
          <span class="text-xl font-bold text-white">Elektriker Södertälje</span>
        </a>
        <p class="text-gray-300">
          {DISCLOSURE}
        </p>
        <p class="text-gray-300">
          Drivs av {COMPANY_NAME}, org.nr {COMPANY_ORG_NR}.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-8 xl:mt-0 xl:col-span-2">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <nav aria-label="Huvudnavigation">
            <h3 class="text-sm font-semibold text-gray-200 tracking-wider uppercase">Navigation</h3>
            <ul role="list" class="mt-4 space-y-4">
              {navigation.main.map((item) => (
                <li>
                  <a 
                    href={item.href} 
                    class="text-base text-gray-300 hover:text-white"
                    aria-label={item.description}
                  >
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav aria-label="Tjänster" class="mt-12 md:mt-0">
            <h3 class="text-sm font-semibold text-gray-200 tracking-wider uppercase">Tjänster</h3>
            <ul role="list" class="mt-4 space-y-4">
              {navigation.services.map((item) => (
                <li>
                  <a 
                    href={item.href} 
                    class="text-base text-gray-300 hover:text-white"
                    aria-label={item.description}
                  >
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <nav aria-label="Områden">
            <h3 class="text-sm font-semibold text-gray-200 tracking-wider uppercase">Områden</h3>
            <ul role="list" class="mt-4 space-y-4">
              {navigation.areas.map((item) => (
                <li>
                  <a 
                    href={item.href} 
                    class="text-base text-gray-300 hover:text-white"
                    aria-label={item.description}
                  >
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav aria-label="Kontaktinformation" class="mt-12 md:mt-0">
            <h3 class="text-sm font-semibold text-gray-200 tracking-wider uppercase">Kontakt</h3>
            <ul role="list" class="mt-4 space-y-4">
              <li>
                <a href="/kontakt" class="text-base text-gray-300 hover:text-white">
                  Skicka förfrågan
                </a>
              </li>
              <li>
                <a
                  href={`mailto:${COMPANY_EMAIL}`}
                  class="text-base text-gray-300 hover:text-white"
                  aria-label="Skicka e-post till oss"
                >
                  {COMPANY_EMAIL}
                </a>
              </li>
              <li>
                <a href="/integritetspolicy" class="text-base text-gray-300 hover:text-white">
                  Integritetspolicy
                </a>
              </li>
            </ul>
          </nav>
      </div>
      </div>
    </div>
    <div class="mt-12 border-t border-gray-800 pt-8">
      <p class="text-base text-gray-400 xl:text-center">
        &copy; {new Date().getFullYear()} {COMPANY_NAME}. {DISCLOSURE}
      </p>
    </div>
  </div>
</footer>