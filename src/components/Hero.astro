---
interface Props {
  badge?: string;
  title: string;
  description: string;
  image: string;
  showCTA?: boolean;
  showHighlights?: boolean;
}

const {
  badge,
  title,
  description,
  image,
  showCTA = true,
  showHighlights = true,
} = Astro.props;

const HIGHLIGHTS = ['Förmedlingstjänst', 'Gratis för dig', 'Ingen förpliktelse', 'Södertälje med omnejd'];
---

<section class="relative bg-gray-900">
  {/* Background layers */}
  <div class="absolute inset-0 overflow-hidden">
    {/* Main image */}
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    
    {/* Gradient overlays */}
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/90 via-gray-900/75 to-gray-900/90"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900/90 via-primary-900/50 to-primary-900/90"></div>
    
    {/* Pattern overlay */}
    <div class="absolute inset-0 opacity-10 mix-blend-overlay">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="hero-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0H20L0 20M40 40V20L20 40" fill="none" stroke="white" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#hero-pattern)" />
      </svg>
    </div>
  </div>
  
  {/* Content */}
  <div class="relative container mx-auto px-4 py-24 lg:py-32">
    <div class="max-w-3xl">
      {badge && (
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-500/20 backdrop-blur-sm border border-primary-400/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-primary-400 mr-2"></span>
          <span class="text-primary-200 text-sm font-medium">{badge}</span>
        </div>
      )}
      
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        {title}
      </h1>
      
      <p class="text-xl text-gray-200 mb-8 max-w-2xl leading-relaxed">
        {description}
      </p>
      
      {showCTA && (
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/kontakt"
            class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-primary-900 bg-white hover:bg-gray-100 transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            Skicka förfrågan
          </a>
          <a
            href="/tjanster#akut-hjalp"
            class="inline-flex items-center justify-center px-6 py-3 border-2 border-white text-base font-medium rounded-lg text-white hover:bg-white hover:text-primary-900 transition-colors duration-200"
          >
            Akut? Läs här först
          </a>
        </div>
      )}
      
      {showHighlights && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12">
          {HIGHLIGHTS.map((highlight) => (
            <div class="flex items-center space-x-2 text-white/90 backdrop-blur-sm bg-white/5 rounded-lg p-3 border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-primary-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>{highlight}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  @keyframes ken-burns {
    0% {
      transform: scale(1.05);
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1.05);
    }
  }

  .animate-ken-burns {
    animation: ken-burns 20s ease-in-out infinite;
  }
</style> 