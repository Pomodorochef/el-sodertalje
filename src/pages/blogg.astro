---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { BLOG_POSTS } from '../data/blogPosts';
import { ORGANIZATION } from '../lib/site';

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Elektriker Södertälje Blog",
  "description": "Allmänna råd och tips om elinstallation, elsäkerhet och energibesparing.",
  "url": "https://elektriker-södertälje.se/blogg",
  "publisher": ORGANIZATION,
  "blogPost": BLOG_POSTS.map(post => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.description,
    "image": `https://elektriker-södertälje.se${post.image}`,
    "datePublished": post.date,
    "dateModified": post.date,
    "author": ORGANIZATION,
    "publisher": ORGANIZATION,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://elektriker-södertälje.se/blogg/${post.id}`
    },
    "keywords": post.tags.join(", "),
    "articleSection": post.category,
    "timeRequired": post.readTime
  }))
};
---

<Layout
  title="Eltips & Råd | Elektriker Södertälje | Guider & Tips"
  description="Allmänna råd om el i hemmet. Läs om elinstallation, elbilsladdare, elsäkerhet och energibesparing. Guider och tips från Elektriker Södertälje, en förmedlingstjänst."
>
  <Header slot="header" />

  <Hero
    badge="Guider och tips"
    title="Råd och tips om el"
    description="Allmänna tips om elinstallation, säkerhet och energibesparing som hjälper dig göra bra val för ditt hem eller företag."
    image="/images/blog/hero.jpg"
    showCTA={true}
    showHighlights={true}
  />

  <!-- Blog Posts Grid -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        {BLOG_POSTS.map(post => (
          <article class="bg-white rounded-lg shadow-sm overflow-hidden border border-gray-100">
            <div class="aspect-w-16 aspect-h-9 bg-gray-100">
              <img
                src={post.image}
                alt={post.title}
                class="object-cover w-full h-full"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center space-x-4 text-sm text-gray-500 mb-4">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('sv-SE', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>•</span>
                <span>{post.category}</span>
              </div>
              
              <h2 class="text-2xl font-bold mb-4">
                <a
                  href={`/blogg/${post.id}`}
                  class="text-gray-900 hover:text-primary-600"
                >
                  {post.title}
                </a>
              </h2>
              
              <p class="text-gray-600 mb-4">
                {post.description}
              </p>

              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <div class="w-8 h-8 rounded-full bg-gray-200"></div>
                  <span class="text-sm text-gray-600">{post.author}</span>
                </div>
                
                <a
                  href={`/blogg/${post.id}`}
                  class="inline-flex items-center text-primary-600 hover:text-primary-700"
                >
                  Läs mer
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Guider & Tips</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {Array.from(new Set(BLOG_POSTS.map(post => post.category))).map(category => {
            const categoryPosts = BLOG_POSTS.filter(post => post.category === category);
            return (
              <div class="bg-white rounded-lg p-6 border border-gray-100">
                <h3 class="text-xl font-bold mb-4">{category}</h3>
                <p class="text-gray-600 mb-4">
                  {category === 'Elbilsladdare' && 'Guider om installation och val av elbilsladdare för hem och företag.'}
                  {category === 'Elsäkerhet' && 'Tips och råd för ett elsäkert hem.'}
                  {category === 'Smart Hem' && 'Moderna lösningar för ett smartare och energieffektivare hem.'}
                  {category === 'Renovering' && 'Råd om elrenovering, kostnader och ROT-avdrag.'}
                </p>
                <ul class="space-y-3">
                  {categoryPosts.map(post => (
                    <li>
                      <a 
                        href={`/blogg/${post.id}`}
                        class="flex items-start hover:text-primary-600"
                      >
                        <svg class="w-5 h-5 text-primary-600 mr-2 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span class="text-sm">{post.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a
                  href={`/blogg/kategori/${category.toLowerCase()}`}
                  class="inline-flex items-center text-primary-600 hover:text-primary-700 mt-4 text-sm font-medium"
                >
                  Se alla artiklar
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout> 