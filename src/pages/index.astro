---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import EmergencyNotice from '../components/EmergencyNotice.astro';
import Hero from '../components/Hero.astro';
import { DISCLOSURE, EMERGENCY_NOTE, ORGANIZATION, WHAT_WE_DO } from '../lib/site';

const SERVICES = [
  {
    title: 'Elinstallation',
    description: 'Installation av el i hem och företag.',
    icon: 'installation',
  },
  {
    title: 'Elbilsladdare',
    description: 'Installation av laddboxar för alla typer av elbilar.',
    icon: 'charger',
  },
  {
    title: 'Akuta elproblem',
    description: EMERGENCY_NOTE,
    icon: 'emergency',
  },
  {
    title: 'Renovering',
    description: 'Elrenovering och uppgradering av äldre system.',
    icon: 'renovation',
  },
];

const TRUST_SIGNALS = [
  { number: '1', label: 'Du beskriver ditt elarbete' },
  { number: '2', label: 'Vi försöker koppla ihop dig med en lokal elektriker' },
  { number: '3', label: 'Du bestämmer själv om du vill gå vidare' },
  { number: '0 kr', label: 'Gratis för dig, utan förpliktelse' },
];

const schema = {
  "@context": "https://schema.org",
  ...ORGANIZATION,
  "description": `Förmedlingstjänst för elarbeten i Södertälje. ${DISCLOSURE}`,
};
---

<Layout 
  title="Elektriker Södertälje | Skicka förfrågan | Förmedlingstjänst"
  description="Behöver du elektriker i Södertälje? Beskriv ditt elarbete, så försöker vi koppla ihop dig med en lokal elektriker. Gratis för dig. Vi är en förmedlingstjänst, inte en elfirma."
>
  <Header slot="header" />
  
  <Hero
    badge="Förmedlingstjänst för elarbeten"
    title="Elektriker i Södertälje – skicka en förfrågan"
    description={`${WHAT_WE_DO} ${DISCLOSURE}`}
    image="/images/hero.jpg"
    showCTA={true}
    showHighlights={true}
  />

  <!-- Trust Signals -->
  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {TRUST_SIGNALS.map(signal => (
          <div class="text-center">
            <p class="text-4xl font-bold text-primary-600">{signal.number}</p>
            <p class="text-gray-600">{signal.label}</p>
    </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Elarbeten du kan skicka förfrågan om</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {SERVICES.map(service => (
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <div class="text-primary-600 mb-4">
              {service.icon === 'installation' && (
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {service.icon === 'charger' && (
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {service.icon === 'emergency' && (
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {service.icon === 'renovation' && (
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21v-2a4 4 0 00-4-4H9a4 4 0 00-4 4v2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3a4 4 0 100 8 4 4 0 000-8z" />
                </svg>
              )}
        </div>
            <h3 class="text-xl font-semibold mb-2">{service.title}</h3>
            <p class="text-gray-600">{service.description}</p>
        </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency guidance -->
  <section class="pb-16">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <EmergencyNotice />
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact" class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Skicka förfrågan</h2>
        <p class="text-gray-600">
          Det är gratis för dig och du förbinder dig inte till något.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>