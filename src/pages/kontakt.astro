---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import EmergencyNotice from '../components/EmergencyNotice.astro';
import Hero from '../components/Hero.astro';
import { COMPANY_EMAIL, COMPANY_NAME, COMPANY_ORG_NR, DISCLOSURE, FREE_NOTE, ORGANIZATION, WHAT_WE_DO } from '../lib/site';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Skicka förfrågan till Elektriker Södertälje",
  "description": `${WHAT_WE_DO} ${DISCLOSURE}`,
  "mainEntity": ORGANIZATION,
};
---

<Layout
  title="Skicka förfrågan | Elektriker Södertälje | Förmedlingstjänst"
  description="Behöver du en elektriker i Södertälje? Beskriv ditt elarbete, så försöker vi koppla ihop dig med en lokal elektriker. Gratis för dig och utan förpliktelse."
>
  <Header slot="header" />

  <Hero
    badge="Skicka förfrågan"
    title="Behöver du hjälp av en elektriker?"
    description={`${WHAT_WE_DO} ${DISCLOSURE}`}
    image="/images/contact/hero.jpg"
    showCTA={false}
    showHighlights={true}
  />

  <!-- Contact Info Grid -->
  <section id="contact" class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div>
          <h2 class="text-2xl font-bold mb-8">Bra att veta</h2>

          <div class="mb-8">
            <EmergencyNotice />
          </div>

          <div class="space-y-6">
            <div>
              <h3 class="font-semibold mb-2">Så fungerar det</h3>
              <p class="text-gray-600">{WHAT_WE_DO} {FREE_NOTE}</p>
            </div>

            <div>
              <h3 class="font-semibold mb-2">E-post</h3>
              <p class="flex items-center text-gray-600">
                <svg class="w-5 h-5 text-primary-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <a href={`mailto:${COMPANY_EMAIL}`} class="hover:text-primary-600">
                  {COMPANY_EMAIL}
                </a>
              </p>
            </div>

            <div>
              <h3 class="font-semibold mb-2">Företag</h3>
              <p class="text-gray-600">{COMPANY_NAME}, org.nr {COMPANY_ORG_NR}</p>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold mb-8">Beskriv ditt elarbete</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
