---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import {
  COMPANY_NAME,
  COMPANY_ORG_NR,
  DISCLOSURE,
  ELSAKERHETSVERKET_URL,
  FREE_NOTE,
  ORGANIZATION,
  WHAT_WE_DO,
} from '../lib/site';

const schema = {
  "@context": "https://schema.org",
  ...ORGANIZATION,
  "description": `Förmedlingstjänst för elarbeten i Södertälje. ${DISCLOSURE}`,
};
---

<Layout
  title="Om oss | Elektriker Södertälje | Förmedlingstjänst"
  description="Elektriker-södertälje.se drivs av Kuruto AB. Vi är en förmedlingstjänst, inte en elfirma. Vi utför inga elarbeten själva."
>
  <Header slot="header" />

  <Hero
    badge="Om tjänsten"
    title="Vi är en förmedlingstjänst"
    description={DISCLOSURE}
    image="/images/about/hero.jpg"
    showCTA={true}
    showHighlights={true}
  />

  <!-- Company Info -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-bold mb-6">Om tjänsten</h2>
          <div class="prose prose-lg">
            <p>{DISCLOSURE}</p>
            <p>{WHAT_WE_DO} {FREE_NOTE}</p>
            <p>Vi kan inte säga när eller om du får svar från en elektriker. Offert, pris och utförande kommer du i så fall överens om direkt med elektrikern.</p>
          </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-4">Vem står bakom?</h3>
          <dl class="space-y-3 text-gray-600">
            <div>
              <dt class="font-medium text-gray-900">Företag</dt>
              <dd>{COMPANY_NAME}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-900">Org.nr</dt>
              <dd>{COMPANY_ORG_NR}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Consumer advice -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Kontrollera den du anlitar</h2>
        <p class="text-gray-600">
          Elarbeten ska utföras av ett registrerat elinstallationsföretag. Du kan kontrollera ett företag i
          <a href={ELSAKERHETSVERKET_URL} class="text-primary-600 hover:underline" rel="noopener noreferrer" target="_blank">Elsäkerhetsverkets register</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Skicka förfrågan</h2>
        <p class="text-gray-600">{FREE_NOTE}</p>
      </div>
      <ContactForm />
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
