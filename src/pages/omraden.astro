---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import { DISCLOSURE, EMERGENCY_NOTE, FREE_NOTE, WHAT_WE_DO, breadcrumbs } from '../lib/site';

const areas = [
  // Central areas
  {
    id: 'centrala-sodertalje',
    name: 'Centrala Södertälje',
    description: 'Skicka en förfrågan om elarbete i Centrala Södertälje.',
    image: '/images/areas/centrala-sodertalje.jpg',
  },
  {
    id: 'sodertalje-syd',
    name: 'Södertälje Syd',
    description: 'Skicka en förfrågan om elarbete i Södertälje Syd.',
    image: '/images/areas/sodertalje-syd.jpg',
  },
  {
    id: 'sodertalje-nord',
    name: 'Södertälje Nord',
    description: 'Skicka en förfrågan om elarbete i Södertälje Nord.',
    image: '/images/areas/sodertalje-nord.jpg',
  },
  
  // Districts
  {
    id: 'jarna',
    name: 'Järna',
    description: 'Skicka en förfrågan om elarbete i Järna.',
    image: '/images/areas/jarna.jpg',
  },
  {
    id: 'holo',
    name: 'Hölö',
    description: 'Skicka en förfrågan om elarbete i Hölö.',
    image: '/images/areas/holo.jpg',
  },
  {
    id: 'pershagen',
    name: 'Pershagen',
    description: 'Skicka en förfrågan om elarbete i Pershagen.',
    image: '/images/areas/pershagen.jpg',
  },
  {
    id: 'ostertalje',
    name: 'Östertälje',
    description: 'Skicka en förfrågan om elarbete i Östertälje.',
    image: '/images/areas/ostertalje.jpg',
  },
  
  // Neighborhoods
  {
    id: 'brunnsang',
    name: 'Brunnsäng',
    description: 'Skicka en förfrågan om elarbete i Brunnsäng.',
    image: '/images/areas/brunnsang.jpg',
  },
  {
    id: 'ronna',
    name: 'Ronna',
    description: 'Skicka en förfrågan om elarbete i Ronna.',
    image: '/images/areas/ronna.jpg',
  },
  {
    id: 'geneta',
    name: 'Geneta',
    description: 'Skicka en förfrågan om elarbete i Geneta.',
    image: '/images/areas/geneta.jpg',
  },
  {
    id: 'hovsjo',
    name: 'Hovsjö',
    description: 'Skicka en förfrågan om elarbete i Hovsjö.',
    image: '/images/areas/hovsjo.jpg',
  },
  {
    id: 'saltskog',
    name: 'Saltskog',
    description: 'Skicka en förfrågan om elarbete i Saltskog.',
    image: '/images/areas/saltskog.jpg',
  },
  {
    id: 'rosenlund',
    name: 'Rosenlund',
    description: 'Skicka en förfrågan om elarbete i Rosenlund.',
    image: '/images/areas/rosenlund.jpg',
  },
  {
    id: 'fornhojden',
    name: 'Fornhöjden',
    description: 'Skicka en förfrågan om elarbete i Fornhöjden.',
    image: '/images/areas/fornhojden.jpg',
  },
  {
    id: 'karlhov',
    name: 'Karlhov',
    description: 'Skicka en förfrågan om elarbete i Karlhov.',
    image: '/images/areas/karlhov.jpg',
  },
  {
    id: 'blombacka',
    name: 'Blombacka',
    description: 'Skicka en förfrågan om elarbete i Blombacka.',
    image: '/images/areas/blombacka.jpg',
  },
];

const schema = breadcrumbs([
  { name: 'Hem', path: '/' },
  { name: 'Områden', path: '/omraden' },
]);
---

<Layout
  title="Elektriker Södertälje | Områden | Skicka förfrågan"
  description="Behöver du en elektriker i Södertälje med omnejd? Beskriv ditt elarbete, så försöker vi koppla ihop dig med en lokal elektriker. Vi är en förmedlingstjänst, inte en elfirma."
>
  <Header slot="header" />

  <Hero
    badge="Elektriker i Södertälje med omnejd"
    title="Behöver du en elektriker i Södertälje?"
    description={`${WHAT_WE_DO} ${DISCLOSURE}`}
    image="/images/areas/overview.jpg"
    showCTA={true}
    showHighlights={true}
  />

  <!-- Main Content -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <!-- Introduction -->
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold mb-6">Så fungerar det</h2>
        <p class="text-lg text-gray-600">
          {WHAT_WE_DO} {FREE_NOTE} {DISCLOSURE}
        </p>
      </div>

      <!-- Services Overview -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <div class="text-primary-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Akuta elproblem</h3>
          <p class="text-gray-600 mb-4">{EMERGENCY_NOTE}</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <div class="text-primary-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Elinstallation</h3>
          <p class="text-gray-600 mb-4">Installation av el i hem och företag. Elarbeten ska utföras av ett registrerat elinstallationsföretag.</p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Nyinstallation
            </li>
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Renovering
            </li>
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Felsökning
            </li>
          </ul>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <div class="text-primary-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Elbilsladdare</h3>
          <p class="text-gray-600 mb-4">Installation av laddbox för elbil, hemma eller på företaget.</p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Installation
            </li>
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Val av laddbox
            </li>
            <li class="flex items-center">
              <svg class="h-5 w-5 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Driftsättning
            </li>
          </ul>
        </div>
      </div>

      <!-- USPs -->
      <div class="bg-gray-50 rounded-2xl p-8 mb-16">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-bold mb-8">Bra att veta</h2>
          <div class="grid md:grid-cols-4 gap-6">
            <div class="text-center">
              <div class="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-semibold mb-2">Förmedling</h3>
              <p class="text-sm text-gray-600">Vi utför inga elarbeten själva</p>
            </div>
            <div class="text-center">
              <div class="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-semibold mb-2">Kontrollera företaget</h3>
              <p class="text-sm text-gray-600">I Elsäkerhetsverkets register</p>
            </div>
            <div class="text-center">
              <div class="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-semibold mb-2">Gratis för dig</h3>
              <p class="text-sm text-gray-600">Att skicka en förfrågan kostar inget</p>
            </div>
            <div class="text-center">
              <div class="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                </svg>
              </div>
              <h3 class="font-semibold mb-2">Ingen förpliktelse</h3>
              <p class="text-sm text-gray-600">Du bestämmer själv om du vill gå vidare</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Areas -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold mb-8 text-center">Områden i Södertälje</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {areas.slice(0, 6).map(area => (
            <a
              href={`/omraden/${area.id}`}
              class="group bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow"
            >
              <div class="aspect-w-16 aspect-h-9">
                <img
                  src={area.image}
                  alt={`Elektriker i ${area.name}`}
                  class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 transition-colors">
                  {area.name}
                </h3>
                <p class="text-gray-600 mb-4">
                  {area.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Alphabetical Areas List -->
      <div class="mt-16 mb-24">
        <h2 class="text-2xl font-bold mb-8 text-center">Fler områden i Södertälje</h2>
        <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto mb-12">
          Här är områden i Södertälje med omnejd där du kan skicka en förfrågan. Vi kan inte garantera att någon kan ta uppdraget.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {areas.sort((a, b) => a.name.localeCompare(b.name)).map(area => (
            <a
              href={`/omraden/${area.id}`}
              class="text-gray-600 hover:text-primary-600 transition-colors flex items-center space-x-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span>{area.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-primary-900 rounded-2xl p-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Behöver du en elektriker?</h2>
        <p class="text-xl text-gray-300 mb-8">
          {WHAT_WE_DO}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/kontakt"
            class="inline-flex items-center px-6 py-3 rounded-lg bg-white text-primary-900 font-medium hover:bg-gray-100 transition-colors"
          >
            Skicka förfrågan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-3xl font-bold mb-6">Skicka förfrågan</h2>
            <p class="text-lg text-gray-600 mb-8">
              {WHAT_WE_DO} {FREE_NOTE}
            </p>
          </div>

          <div>
            <ContactForm description="" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout> 