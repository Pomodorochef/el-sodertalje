---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmergencyNotice from '../components/EmergencyNotice.astro';
---

<Layout
  title="Tack för din förfrågan | Elektriker Södertälje"
  description="Tack för din förfrågan. Vi försöker koppla ihop dig med en lokal elektriker, men kan inte garantera att någon kan ta uppdraget."
>
  <Header slot="header" />

  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <div class="text-primary-600 mb-6">
          <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>

        <h1 class="text-4xl font-bold mb-4">Tack för din förfrågan!</h1>
        <p class="text-xl text-gray-600 mb-8">
          Vi har tagit emot din förfrågan och försöker koppla ihop dig med en lokal elektriker. Vi kan inte garantera att någon kan ta uppdraget.
        </p>

        <div class="mb-8 text-left">
          <EmergencyNotice />
        </div>

        <p class="text-gray-600">
          Frågor om tjänsten eller dina uppgifter? Skriv till oss via
          <a href="/kontakt" class="text-primary-600 hover:underline">kontaktformuläret</a>.
        </p>

        <div class="mt-12">
          <a
            href="/"
            class="inline-flex items-center text-primary-600 hover:text-primary-700"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Tillbaka till startsidan
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
