---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import { DISCLOSURE, ELSAKERHETSVERKET_URL, EMERGENCY_NOTE, FREE_NOTE, ROT_NOTE, SKATTEVERKET_URL, WHAT_WE_DO, breadcrumbs } from '../lib/site';

const SERVICES = [
  {
    id: 'elinstallation',
    title: 'Elinstallation',
    description: 'Installation av el i hem och företag.',
    longDescription: `Du kan till exempel skicka förfrågan om:
• Nyinstallation av el
• Utbyte av elcentral
• Installation av belysning
• Jordfelsbrytare och säkringar
• Felsökning och reparation`,
    icon: 'installation',
  },
  {
    id: 'elbilsladdare',
    title: 'Elbilsladdare',
    description: 'Installation av laddbox för elbil.',
    longDescription: `Du kan till exempel skicka förfrågan om:
• Råd om lämplig laddbox
• Installation av laddbox
• Driftsättning och test`,
    icon: 'charger',
  },
  {
    id: 'akut-hjalp',
    title: 'Akuta elproblem',
    description: EMERGENCY_NOTE,
    longDescription: '',
    icon: 'emergency',
  },
  {
    id: 'renovering',
    title: 'Renovering',
    description: 'Elrenovering och uppgradering av äldre system.',
    longDescription: `Du kan till exempel skicka förfrågan om:
• Byte av gamla elledningar
• Modernisering av elcentral
• Installation av jordfelsbrytare
• Uppgradering av äldre system`,
    icon: 'renovation',
  },
];

const schema = breadcrumbs([
  { name: 'Hem', path: '/' },
  { name: 'Tjänster', path: '/tjanster' },
]);
---

<Layout
  title="Elektriker Södertälje - Skicka förfrågan om elinstallation och elbilsladdare"
  description="Skicka förfrågan om elinstallation, elbilsladdare eller elrenovering i Södertälje, så försöker vi koppla ihop dig med en lokal elektriker. Vi är en förmedlingstjänst, inte en elfirma."
>
  <Header slot="header" />

  <Hero
    badge="Förmedlingstjänst för elarbeten"
    title="Elarbeten du kan skicka förfrågan om"
    description={`${WHAT_WE_DO} ${DISCLOSURE}`}
    image="/images/services/hero.jpg"
    showCTA={true}
    showHighlights={true}
  />

  <!-- Services Grid -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        {SERVICES.map(service => (
          <section id={service.id} class="scroll-mt-8 bg-white rounded-lg shadow-sm overflow-hidden border border-gray-100">
            <div class="p-8">
              <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-lg flex items-center justify-center mb-6">
                {service.icon === 'installation' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {service.icon === 'charger' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {service.icon === 'emergency' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                )}
                {service.icon === 'renovation' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
              </div>

              <h2 class="text-2xl font-bold mb-4">{service.title}</h2>
              <p class="text-gray-600 mb-6">{service.description}</p>

              {service.longDescription && (
                <div class="space-y-2">
                  {service.longDescription.split('\n').map(line => (
                    line.startsWith('•') ? (
                      <p class="flex items-start">
                        <span class="text-primary-600 mr-2">•</span>
                        <span>{line.replace('•', '').trim()}</span>
                      </p>
                    ) : (
                      <p class="text-gray-600 mb-2">{line}</p>
                    )
                  ))}
                </div>
              )}

              {service.id !== 'akut-hjalp' && (
                <div class="mt-8">
                  <a
                    href="/kontakt"
                    class="inline-flex items-center justify-center px-6 py-2 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700"
                  >
                    Skicka förfrågan
                  </a>
                </div>
              )}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Consumer advice -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold mb-6 text-center">Bra att veta</h2>
        <div class="prose prose-lg max-w-none">
          <p>
            Elarbeten ska utföras av ett registrerat elinstallationsföretag. Du kan kontrollera ett företag i
            <a href={ELSAKERHETSVERKET_URL} rel="noopener noreferrer" target="_blank">Elsäkerhetsverkets register</a>.
          </p>
          <p>
            {ROT_NOTE} För laddbox kan skattereduktion för grön teknik vara aktuell i stället. Läs mer hos
            <a href={SKATTEVERKET_URL} rel="noopener noreferrer" target="_blank">Skatteverket</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="contact" class="bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Behöver du hjälp med elarbeten?</h2>
        <p class="text-xl text-gray-600 mb-8">
          {FREE_NOTE}
        </p>
        <ContactForm />
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout> 